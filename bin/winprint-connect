class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.resize(780, 600)
        self.setMinimumSize(680, 500)
        self.setWindowIcon(QIcon.fromTheme("printer", QIcon.fromTheme("network-wired")))
        self.cfg = ConfigManager.load()
        self.init_ui()

    def init_ui(self):
        central = QWidget(self)
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setContentsMargins(24, 24, 24, 24)
        main_layout.setSpacing(16)

        # 1. Header Box (Icon + Titles + Live Host Counter)
        header_layout = QHBoxLayout()
        header_layout.setSpacing(16)

        header_icon_box = QFrame(self)
        header_icon_box.setObjectName("HeaderIconBox")
        header_icon_box.setFixedSize(56, 56)
        hib_layout = QVBoxLayout(header_icon_box)
        hib_layout.setContentsMargins(0, 0, 0, 0)
        hib_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        icon_lbl = QLabel(header_icon_box)
        icon_lbl.setPixmap(QIcon.fromTheme("printer").pixmap(40, 40))
        icon_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        hib_layout.addWidget(icon_lbl)
        header_layout.addWidget(header_icon_box)

        head_text_layout = QVBoxLayout()
        head_text_layout.setSpacing(3)

        title = QLabel(APP_NAME, self)
        font_title = QFont()
        font_title.setPointSize(14)
        font_title.setBold(True)
        title.setFont(font_title)
        head_text_layout.addWidget(title)

        subtitle = QLabel("Pindai dan hubungkan printer share Windows 10/11 langsung ke antrean CUPS KDE.", self)
        subtitle.setObjectName("SubText")
        head_text_layout.addWidget(subtitle)

        header_layout.addLayout(head_text_layout)
        header_layout.addStretch()

        # Web CUPS quick link button
        btn_cups_web = QPushButton("Web CUPS", self)
        btn_cups_web.setIcon(QIcon.fromTheme("applications-internet"))
        btn_cups_web.setToolTip("Buka halaman antarmuka web CUPS di browser")
        btn_cups_web.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_cups_web.clicked.connect(lambda: QDesktopServices.openUrl(QUrl("http://localhost:631/printers/")))
        header_layout.addWidget(btn_cups_web)

        main_layout.addLayout(header_layout)

        # 2. Search & Discovery Group Frame
        search_frame = QFrame(self)
        search_frame.setObjectName("SearchFrame")
        search_frame.setFrameShape(QFrame.Shape.StyledPanel)
        sf_layout = QVBoxLayout(search_frame)
        sf_layout.setContentsMargins(18, 18, 18, 18)
        sf_layout.setSpacing(12)

        host_row = QHBoxLayout()
        host_row.setSpacing(10)

        host_lbl = QLabel("Host / IP Windows:", self)
        font_lbl = QFont()
        font_lbl.setBold(True)
        host_lbl.setFont(font_lbl)

        # Editable ComboBox for Host History
        self.host_combo = QComboBox(self)
        self.host_combo.setEditable(True)
        self.host_combo.setInsertPolicy(QComboBox.InsertPolicy.InsertAtTop)
        self.host_combo.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.host_combo.setToolTip("Pilih dari riwayat atau ketik IP/hostname Windows")

        # Populate history
        recent = self.cfg.get("recent_hosts", [DEFAULT_HOST])
        for h in recent:
            self.host_combo.addItem(h)
        last_host = self.cfg.get("last_host", DEFAULT_HOST)
        self.host_combo.setCurrentText(last_host)
        self.host_combo.lineEdit().returnPressed.connect(self.start_scan)

        # Scan Printer button (Primary)
        self.btn_scan = QPushButton("  Cari Printer", self)
        self.btn_scan.setIcon(QIcon.fromTheme("edit-find", QIcon.fromTheme("system-search")))
        self.btn_scan.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_scan.setObjectName("PrimaryButton")
        self.btn_scan.setToolTip("Cari printer yang dibagikan pada host ini")
        self.btn_scan.clicked.connect(self.start_scan)

        # Auto-Discover LAN button (Secondary)
        self.btn_discover = QPushButton("  Scan LAN", self)
        self.btn_discover.setIcon(QIcon.fromTheme("network-workgroup", QIcon.fromTheme("network-wired")))
        self.btn_discover.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_discover.setToolTip("Pindai otomatis PC Windows aktif di subnet lokal")
        self.btn_discover.clicked.connect(self.start_subnet_scan)

        host_row.addWidget(host_lbl)
        host_row.addWidget(self.host_combo, stretch=1)
        host_row.addWidget(self.btn_scan)
        host_row.addWidget(self.btn_discover)
        sf_layout.addLayout(host_row)

        # Optional Auth Row
        self.chk_auth = QCheckBox("Gunakan Akun Windows (Bila Printer Memerlukan Username & Password)", self)
        self.chk_auth.setToolTip("Aktifkan jika PC Windows tidak mengizinkan guest/anonymous access")
        self.chk_auth.setChecked(self.cfg.get("auth", {}).get("remember", False))
        self.chk_auth.toggled.connect(self.toggle_auth_fields)
        sf_layout.addWidget(self.chk_auth)

        self.auth_widget = QWidget(self)
        auth_row = QHBoxLayout(self.auth_widget)
        auth_row.setContentsMargins(0, 4, 0, 0)
        auth_row.setSpacing(12)

        u_lbl = QLabel("User:", self)
        self.user_input = QLineEdit(self.cfg.get("auth", {}).get("username", "jasanet"), self)
        self.user_input.setPlaceholderText("Username Windows")

        p_lbl = QLabel("Password:", self)
        self.pass_input = QLineEdit(self)
        self.pass_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.pass_input.setPlaceholderText("Password")

        auth_row.addWidget(u_lbl)
        auth_row.addWidget(self.user_input, stretch=1)
        auth_row.addWidget(p_lbl)
        auth_row.addWidget(self.pass_input, stretch=1)

        self.auth_widget.setVisible(self.chk_auth.isChecked())
        sf_layout.addWidget(self.auth_widget)

        main_layout.addWidget(search_frame)

        # 3. Status Bar & Animated Progress Indicator
        status_box = QHBoxLayout()
        status_box.setSpacing(8)

        self.status_lbl = QLabel("Pilih IP/hostname Windows lalu klik 'Cari Printer' atau gunakan 'Scan LAN'.", self)
        self.status_lbl.setObjectName("SubText")
        status_box.addWidget(self.status_lbl)
        status_box.addStretch()

        self.rescan_btn = QPushButton("Refresh Status", self)
        self.rescan_btn.setIcon(QIcon.fromTheme("view-refresh"))
        self.rescan_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.rescan_btn.setToolTip("Perbarui status terhubung dari CUPS")
        self.rescan_btn.clicked.connect(self.refresh_cards_status)
        self.rescan_btn.setVisible(False)
        status_box.addWidget(self.rescan_btn)

        main_layout.addLayout(status_box)

        self.progress_bar = QProgressBar(self)
        self.progress_bar.setRange(0, 0)
        self.progress_bar.setVisible(False)
        self.progress_bar.setFixedHeight(4)
        self.progress_bar.setTextVisible(False)
        main_layout.addWidget(self.progress_bar)

        # 4. Result Area (Scroll Area for Printer Cards)
        self.scroll_area = QScrollArea(self)
        self.scroll_area.setWidgetResizable(True)
        self.scroll_area.setFrameShape(QFrame.Shape.NoFrame)

        self.scroll_content = QWidget()
        self.scroll_layout = QVBoxLayout(self.scroll_content)
        self.scroll_layout.setContentsMargins(0, 0, 0, 0)
        self.scroll_layout.setSpacing(12)

        # Initial Empty State Placeholder
        self.empty_state = QFrame(self.scroll_content)
        self.empty_state.setObjectName("EmptyStateFrame")
        es_layout = QVBoxLayout(self.empty_state)
        es_layout.setContentsMargins(24, 48, 24, 48)
        es_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        es_layout.setSpacing(12)

        es_icon = QLabel(self.empty_state)
        es_icon.setPixmap(QIcon.fromTheme("network-workgroup").pixmap(48, 48))
        es_icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        es_layout.addWidget(es_icon)

        es_text = QLabel("Belum ada printer yang dimuat.\nKlik 'Cari Printer' untuk melihat daftar printer share di PC target.", self.empty_state)
        es_text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        es_text.setObjectName("SubText")
        es_layout.addWidget(es_text)

        self.scroll_layout.addWidget(self.empty_state)
        self.scroll_layout.addStretch()

        self.scroll_area.setWidget(self.scroll_content)
        main_layout.addWidget(self.scroll_area, stretch=1)

        # 5. Footer Buttons
        footer_layout = QHBoxLayout()
        footer_layout.setSpacing(12)

        btn_kde = QPushButton("Buka Pengaturan Printer KDE", self)
        btn_kde.setIcon(QIcon.fromTheme("configure", QIcon.fromTheme("preferences-system")))
        btn_kde.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_kde.setToolTip("Buka kontrol panel printer KDE System Settings")
        btn_kde.clicked.connect(self.open_kde_settings)
        footer_layout.addWidget(btn_kde)

        footer_layout.addStretch()

        btn_close = QPushButton("Tutup", self)
        btn_close.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_close.clicked.connect(self.close)
        footer_layout.addWidget(btn_close)

        main_layout.addLayout(footer_layout)

    def toggle_auth_fields(self, checked):
        self.auth_widget.setVisible(checked)

    def save_host_to_history(self, host):
        recent = self.cfg.get("recent_hosts", [])
        if host in recent:
            recent.remove(host)
        recent.insert(0, host)
        self.cfg["recent_hosts"] = recent[:8]
        self.cfg["last_host"] = host
        self.cfg["auth"] = {
            "remember": self.chk_auth.isChecked(),
            "username": self.user_input.text().strip()
        }
        ConfigManager.save(self.cfg)

    def start_subnet_scan(self):
        self.btn_discover.setEnabled(False)
        self.btn_scan.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.status_lbl.setText("Memindai subnet lokal untuk menemukan PC Windows aktif...")

        self.subnet_worker = SubnetScanWorker()
        self.subnet_worker.status.connect(lambda msg: self.status_lbl.setText(msg))
        self.subnet_worker.finished.connect(self.on_subnet_scan_finished)
        self.subnet_worker.start()

    def on_subnet_scan_finished(self, found_hosts):
        self.btn_discover.setEnabled(True)
        self.btn_scan.setEnabled(True)
        self.progress_bar.setVisible(False)

        if not found_hosts:
            self.status_lbl.setText("Tidak ada PC SMB yang ditemukan di subnet lokal.")
            QMessageBox.information(self, "Hasil Scan LAN", "Tidak ditemukan PC Windows SMB aktif di subnet lokal.")
            return

        self.status_lbl.setText(f"Ditemukan {len(found_hosts)} PC Windows/SMB di jaringan lokal.")

        # Update ComboBox items with display string e.g. "192.168.41.2 (PMU-ACC1)"
        current_text = self.host_combo.currentText().strip()
        for item in reversed(found_hosts):
            disp = item["display"]
            idx = self.host_combo.findText(disp)
            if idx >= 0:
                self.host_combo.removeItem(idx)
            self.host_combo.insertItem(0, disp)

        if found_hosts and (not current_text or self.host_combo.findText(current_text) < 0):
            self.host_combo.setCurrentText(found_hosts[0]["display"])

    def start_scan(self):
        raw_target = self.host_combo.currentText().strip()
        if not raw_target:
            QMessageBox.warning(self, "Peringatan", "Harap pilih atau masukkan Host/IP Windows.")
            return

        clean_host = extract_host(raw_target)
        self.save_host_to_history(raw_target)
        self.btn_scan.setEnabled(False)
        self.btn_discover.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.status_lbl.setText(f"Menghubungi {raw_target} dan memindai printer yang dibagikan...")

        username = self.user_input.text().strip() if self.chk_auth.isChecked() else ""
        password = self.pass_input.text().strip() if self.chk_auth.isChecked() else ""

        self.worker = SmbScanWorker(clean_host, username, password)
        self.worker.finished.connect(self.on_scan_finished)
        self.worker.error.connect(self.on_scan_error)
        self.worker.start()

    def on_scan_finished(self, printers, host):
        self.btn_scan.setEnabled(True)
        self.btn_discover.setEnabled(True)
        self.progress_bar.setVisible(False)

        # Clear scroll layout except stretch at end
        while self.scroll_layout.count() > 1:
            item = self.scroll_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        if not printers:
            self.status_lbl.setText(f"Tidak ada printer share yang ditemukan di {host}.")
            self.rescan_btn.setVisible(False)
            QMessageBox.information(
                self, "Hasil Pemindaian",
                f"Tidak ditemukan printer yang dibagikan di '{host}'.\nPastikan fitur 'Share this printer' telah diaktifkan pada Windows."
            )
            return

        self.status_lbl.setText(f"Ditemukan {len(printers)} printer share di {host}:")
        self.rescan_btn.setVisible(True)

        auth_info = {
            "username": self.user_input.text().strip() if self.chk_auth.isChecked() else "",
            "password": self.pass_input.text().strip() if self.chk_auth.isChecked() else ""
        }

        for p in printers:
            card = PrinterCard(p, auth_info, self.scroll_content)
            card.status_changed.connect(self.refresh_cards_status)
            self.scroll_layout.insertWidget(self.scroll_layout.count() - 1, card)

    def on_scan_error(self, err_msg):
        self.btn_scan.setEnabled(True)
        self.btn_discover.setEnabled(True)
        self.progress_bar.setVisible(False)
        self.status_lbl.setText("Gagal memindai printer.")
        QMessageBox.warning(self, "Pemindaian Gagal", err_msg)

    def refresh_cards_status(self):
        for i in range(self.scroll_layout.count() - 1):
            widget = self.scroll_layout.itemAt(i).widget()
            if isinstance(widget, PrinterCard):
                widget.update_status()

    def open_kde_settings(self):
        try:
            subprocess.Popen(["kcmshell6", "kcm_printer_manager"])
        except Exception:
            try:
                subprocess.Popen(["system-config-printer"])
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Tidak dapat membuka pengaturan: {str(e)}")


