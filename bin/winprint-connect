#!/usr/bin/env python3
"""
WinPrint Connect - Windows Shared Printer Connector for Linux (KDE/CUPS)
Pixel-perfect, OCD-friendly, WCAG AA compliant SMB printer discovery & setup tool.
"""

import sys
import os
import re
import json
import socket
import struct
import ipaddress
import urllib.parse
import urllib.request
import ssl
import subprocess
from concurrent.futures import ThreadPoolExecutor

from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QLineEdit, QPushButton, QScrollArea, QFrame, QComboBox,
    QCheckBox, QProgressBar, QMessageBox, QSizePolicy, QSpacerItem
)
from PySide6.QtCore import Qt, QThread, Signal
from PySide6.QtGui import QIcon, QFont, QPalette, QColor, QDesktopServices
from PySide6.QtCore import QUrl

APP_NAME = "WinPrint Connect"
CONFIG_DIR = os.path.expanduser("~/.config/winprint-connect")
CONFIG_FILE = os.path.join(CONFIG_DIR, "history.json")
DEFAULT_HOST = "192.168.25.5"

DRIVERS = [
    ("auto", "Deteksi Otomatis (Rekomendasi)"),
    ("drv:///sample.drv/epson9.ppd", "Epson Dot Matrix 9-Pin (LX-310 / LX-300)"),
    ("drv:///sample.drv/epson24.ppd", "Epson Dot Matrix 24-Pin (LQ Series)"),
    ("drv:///sample.drv/generic.ppd", "Generic PostScript Printer"),
    ("drv:///sample.drv/generpcl.ppd", "Generic PCL Laser Printer"),
    ("raw", "Raw Passthrough (Windows Spooler)"),
]

# Katalog driver nyata dari `lpinfo -m`, diisi DriverCatalogWorker saat start.
DRIVER_CATALOG = []
DRIVER_CATALOG_VERSION = 0

GENERIC_DRIVER_KEYS = {
    "auto", "raw",
    "drv:///sample.drv/epson9.ppd",
    "drv:///sample.drv/epson24.ppd",
    "drv:///sample.drv/generic.ppd",
    "drv:///sample.drv/generpcl.ppd",
}

BRAND_TOKENS = (
    "hewlett", "hp", "brother", "epson", "canon", "samsung", "lexmark", "xerox",
    "ricoh", "kyocera", "konica", "minolta", "sharp", "toshiba", "oki", "dell",
    "lenovo", "pantum", "fuji", "zebra", "dymo", "citizen",
)

_MODEL_CODE_RE = re.compile(r"([a-z]{1,5})\s*-?\s*(\d{3,6})([a-z]{0,2})")

PAPERCUT_IPP_PORTS = [(9163, "http", "ipp"), (9164, "https", "ipps")]
PAPERCUT_WEB_PORTS = [(9191, "http"), (9192, "https")]
PAPERCUT_CLIENT_SHARE = "pcclient"


# ============================================================================
# Helpers & Utilities
# ============================================================================

def extract_host(target: str) -> str:
    """Extract clean IP or hostname from display string like '192.168.41.2 (PMU-ACC1)'"""
    target = target.strip()
    m = re.match(r'^(\d{1,3}(?:\.\d{1,3}){3})', target)
    if m:
        return m.group(1)
    m = re.match(r'^([^\s()]+)', target)
    if m:
        return m.group(1)
    return target


def get_netbios_name(ip: str, timeout: float = 0.25) -> str:
    """Query NetBIOS Node Status (RFC 1002) over UDP 137 to resolve Windows Computer Name."""
    query = (
        b'\xa2\x48\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00'
        b'\x20CKAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\x00'
        b'\x00\x21\x00\x01'
    )
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        s.sendto(query, (ip, 137))
        data, _ = s.recvfrom(1024)
        if len(data) > 57:
            num_names = data[56]
            offset = 57
            for _ in range(num_names):
                if offset + 18 <= len(data):
                    name_bytes = data[offset:offset+15]
                    name_type = data[offset+15]
                    flags = struct.unpack('>H', data[offset+16:offset+18])[0]
                    offset += 18
                    if (flags & 0x8000) == 0 and name_type in (0x00, 0x20):
                        name = name_bytes.decode('ascii', errors='ignore').strip()
                        if name:
                            return name
    except Exception:
        pass
    finally:
        s.close()
    try:
        return socket.gethostbyaddr(ip)[0]
    except Exception:
        pass
    return ""


def get_active_subnet() -> str:
    """Detect local active IPv4 network interface CIDR."""
    try:
        res = subprocess.run(['ip', '-j', 'addr', 'show', 'up'], capture_output=True, text=True)
        data = json.loads(res.stdout)
        for iface in data:
            if iface.get('ifname') == 'lo':
                continue
            for addr in iface.get('addr_info', []):
                if addr.get('family') == 'inet':
                    return f"{addr['local']}/{addr['prefixlen']}"
    except Exception:
        pass
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(('8.8.8.8', 80))
        ip = s.getsockname()[0]
        s.close()
        return f"{ip}/24"
    except Exception:
        return "192.168.25.0/24"


def sanitize_cups_name(name: str) -> str:
    cleaned = re.sub(r'[^a-zA-Z0-9_\-]', '_', name)
    cleaned = re.sub(r'_+', '_', cleaned).strip('_')
    return cleaned or "printer"


def parse_model_codes(text: str):
    """Return (brand token, [(prefix, digits, suffix), ...]) for a printer name or PPD label."""
    lower = text.lower()
    brand = next((t for t in BRAND_TOKENS if t in lower), "")
    codes = [(m.group(1), m.group(2), m.group(3)) for m in _MODEL_CODE_RE.finditer(lower)]
    return brand, codes


def match_catalog_driver(text: str, limit: int = 12):
    """Rank installed CUPS drivers against a share name using brand + model code."""
    if not DRIVER_CATALOG or not text:
        return []
    brand, want = parse_model_codes(text)
    if not want:
        return []
    scored = []
    for key, label in DRIVER_CATALOG:
        drv_brand, have = parse_model_codes(label)
        if brand and drv_brand and drv_brand != brand:
            continue
        for w_prefix, w_digits, w_suffix in want:
            for d_prefix, d_digits, d_suffix in have:
                if w_prefix != d_prefix:
                    continue
                # Same generation: equal length and equal leading group (HL-1201 ~ HL-1200).
                if len(w_digits) != len(d_digits) or w_digits[:3] != d_digits[:3]:
                    continue
                scored.append((
                    (
                        d_digits == w_digits and d_suffix == w_suffix,
                        d_digits == w_digits,
                        not d_suffix,
                        drv_brand == brand,
                        key.startswith("drv://"),
                        -len(label),
                    ),
                    key,
                    label,
                ))
                break
    scored.sort(key=lambda item: item[0], reverse=True)
    results, seen = [], set()
    for _, key, label in scored:
        if key in seen:
            continue
        seen.add(key)
        results.append((key, label))
        if len(results) >= limit:
            break
    return results


def guess_driver_for_name(text: str) -> str:
    """Pick the best installed driver for a share; fall back to generic PostScript."""
    matches = match_catalog_driver(text, limit=1)
    if matches:
        return matches[0][0]
    return "drv:///sample.drv/generic.ppd"


def driver_warnings(key: str, share_name: str):
    """Return user-facing warnings about a chosen driver."""
    warnings = []
    brand, _ = parse_model_codes(share_name)
    label = next((lbl for k, lbl in DRIVER_CATALOG if k == key), "")
    if "requires proprietary plugin" in label.lower():
        warnings.append(
            "PPD ini butuh plugin proprietary HP. Bila plugin belum terdaftar, job akan "
            "gagal senyap; jalankan `hp-plugin -i` lalu cetak ulang."
        )
    if brand in ("brother", "canon", "samsung", "lexmark") and not key.startswith(("drv:///brlaser", "drv:///splix")):
        # These vendors ship host-based (GDI) lasers far more often than PostScript ones.
        warnings.append(
            f"Kebanyakan laser {brand.title()} bersifat host-based (GDI), bukan PostScript/PCL. "
            "Job dari PPD generic akan terkirim tapi tidak tercetak. Pastikan PPD model asli "
            "(mis. brlaser untuk Brother HL/DCP, splix untuk Samsung) benar-benar terdaftar."
        )
    if key in ("drv:///sample.drv/generic.ppd", "drv:///sample.drv/generpcl.ppd") and brand:
        if DRIVER_CATALOG and not match_catalog_driver(share_name):
            warnings.append(
                "Tidak ada PPD spesifik model ini di katalog CUPS; yang dipilih hanya driver generic. "
                "Cek driver resmi vendor (mis. epson-inkjet-printer-escpr/-202101w, brlaser, hplip) "
                "sebelum menghubungkan."
            )
    if key.startswith("gutenprint") and brand == "epson":
        warnings.append(
            "PPD Gutenprint hanya mendekati model asli. Bila hasil cetak kabur atau warna "
            "salah, pasang PPD resmi Epson (epson-inkjet-printer-escpr / -202101w)."
        )
    return warnings


def load_driver_catalog():
    """Query CUPS for every installed driver; tolerant of a missing lpinfo."""
    global DRIVER_CATALOG, DRIVER_CATALOG_VERSION
    catalog, seen = [], set()
    try:
        res = subprocess.run(["lpinfo", "-m"], capture_output=True, text=True, timeout=60)
        for line in res.stdout.splitlines():
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            key, label = parts[0].strip(), parts[1].strip()
            if key == "raw" or key in GENERIC_DRIVER_KEYS:
                continue
            # The same PPD is listed as drv:///... and as lsb/usr/...gz; keep the drv:// form.
            basename = os.path.basename(key).removesuffix(".gz").removesuffix(".ppd")
            if basename in seen:
                continue
            seen.add(basename)
            catalog.append((key, label))
    except Exception:
        pass
    DRIVER_CATALOG = catalog
    DRIVER_CATALOG_VERSION += 1
    return catalog


def get_installed_cups_printers() -> dict:
    installed = {}
    try:
        res = subprocess.run(["lpstat", "-v"], capture_output=True, text=True, timeout=5)
        for line in res.stdout.splitlines():
            m = re.match(r"^device for (.*?):\s+(.*)$", line)
            if m:
                pname = m.group(1).strip()
                uri = m.group(2).strip()
                installed[pname] = uri
    except Exception:
        pass
    return installed


def get_default_cups_printer() -> str:
    try:
        res = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, timeout=5)
        m = re.search(r"destination:\s*(\S+)", res.stdout)
        if m:
            return m.group(1).strip()
    except Exception:
        pass
    return ""


def port_open(host: str, port: int, timeout: float = 0.4) -> bool:
    """Probe a single TCP port without raising."""
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.settimeout(timeout)
        return s.connect_ex((host, port)) == 0
    except Exception:
        return False
    finally:
        s.close()


def fetch_papercut_printers(host: str, port: int, scheme: str) -> list:
    """GET {scheme}://{host}:{port}/printers and return [{'name': ...}]."""
    url = f"{scheme}://{host}:{port}/printers"
    ctx = None
    if scheme == "https":
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(url, timeout=5, context=ctx) as r:
            data = json.loads(r.read())
    except Exception:
        return []
    if not isinstance(data, list):
        return []
    seen = set()
    printers = []
    for item in data:
        if isinstance(item, dict):
            name = item.get("name")
        elif isinstance(item, str):
            name = item
        else:
            continue
        if not isinstance(name, str):
            continue
        name = name.strip()
        if not name or name in seen:
            continue
        seen.add(name)
        printers.append({"name": name})
    return printers


def papercut_device_uri(host, port, scheme, name, username="", password="") -> str:
    """Build the CUPS device URI for a PaperCut Mobility Print queue."""
    ipp_name = name.replace(" ", "+")
    if username and password:
        auth = f"{urllib.parse.quote(username)}:{urllib.parse.quote(password)}@"
    elif username:
        auth = f"{urllib.parse.quote(username)}@"
    else:
        auth = ""
    return f"{scheme}://{auth}{host}:{port}/printers/{ipp_name}"


def probe_papercut(host: str) -> dict:
    """Detect PaperCut Mobility Print (IPP) and NG/MF console on host."""
    result = {"host": host, "ipp_port": None, "ipp_scheme": None, "web_url": None, "printers": []}
    if not host:
        return result

    try:
        for port, http_scheme, ipp_scheme in PAPERCUT_IPP_PORTS:
            if not port_open(host, port):
                continue
            printers = fetch_papercut_printers(host, port, http_scheme)
            if printers:
                result["ipp_port"] = port
                result["ipp_scheme"] = ipp_scheme
                result["printers"] = printers
                break
    except Exception:
        pass

    try:
        for port, http_scheme in PAPERCUT_WEB_PORTS:
            if port_open(host, port):
                result["web_url"] = f"{http_scheme}://{host}:{port}/user"
                break
    except Exception:
        pass

    return result


def parse_smb_listing(output: str):
    """Split `smbclient -L` output into (printer shares, disk share names)."""
    printers, disks = [], []
    for line in output.splitlines():
        m = re.match(r"^\t(?!.*?\bDisk\b)(.*?)\s+Printer\s*(.*)$", line)
        if m:
            printers.append({"sharename": m.group(1).strip(), "comment": m.group(2).strip()})
            continue
        m = re.match(r"^\t(.*?)\s+Disk\s*(.*)$", line)
        if m:
            disks.append(m.group(1).strip())
    return printers, disks


# ============================================================================
# Configuration Management
# ============================================================================

class ConfigManager:
    @staticmethod
    def load() -> dict:
        default_cfg = {
            "recent_hosts": [DEFAULT_HOST, "pc1"],
            "last_host": DEFAULT_HOST,
            "auth": {
                "remember": False,
                "username": "jasanet"
            }
        }
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    default_cfg.update(data)
            except Exception:
                pass
        return default_cfg

    @staticmethod
    def save(cfg: dict):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
        except Exception:
            pass


# ============================================================================
# Background Threads (Workers)
# ============================================================================

class SubnetScanWorker(QThread):
    finished = Signal(list)
    status = Signal(str)

    def run(self):
        self.status.emit("Mendeteksi antarmuka jaringan lokal...")
        cidr = get_active_subnet()
        net = ipaddress.IPv4Network(cidr, strict=False)
        self.status.emit(f"Memindai host SMB & nama PC di subnet {net.network_address}/{net.prefixlen}...")

        def check_host(ip_str):
            for port in (445, 139):
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(0.18)
                try:
                    if sock.connect_ex((ip_str, port)) == 0:
                        sock.close()
                        hostname = get_netbios_name(ip_str)
                        display = f"{ip_str} ({hostname})" if hostname else ip_str
                        return {"ip": ip_str, "hostname": hostname, "display": display}
                except Exception:
                    pass
                finally:
                    sock.close()
            return None

        # Scan up to 256 hosts in subnet
        hosts_to_scan = [str(h) for h in list(net.hosts())[:256]]
        found = []
        with ThreadPoolExecutor(max_workers=40) as pool:
            for item in pool.map(check_host, hosts_to_scan):
                if item:
                    found.append(item)

        self.finished.emit(found)


class SmbScanWorker(QThread):
    finished = Signal(list, str)
    error = Signal(str)

    def __init__(self, host, username="", password=""):
        super().__init__()
        self.host = host.strip()
        self.username = username.strip()
        self.password = password.strip()
        self.disk_shares = []

    def run(self):
        if not self.host:
            self.error.emit("Silakan masukkan Hostname atau IP Windows.")
            return

        cmd = ["smbclient", "-L", f"//{self.host}"]
        if self.username:
            auth = f"{self.username}%{self.password}"
            cmd.extend(["-U", auth])
        else:
            cmd.append("-N")

        env = os.environ.copy()
        env["SMB_CONF_PATH"] = "/dev/null"

        try:
            res = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=10)
            output = res.stdout
            err = res.stderr

            if "NT_STATUS_LOGON_FAILURE" in err or "LOGON_FAILURE" in output:
                self.error.emit("Gagal login ke Windows: Username atau password salah.")
                return

            if "NT_STATUS_ACCESS_DENIED" in err and not self.username:
                self.error.emit("Akses ditolak: Windows memerlukan akun/password untuk melihat printer.")
                return

            printers, self.disk_shares = parse_smb_listing(output)
            for p in printers:
                p["host"] = self.host

            self.finished.emit(printers, self.host)
        except subprocess.TimeoutExpired:
            self.error.emit(f"Koneksi timeout ke {self.host}. Pastikan PC Windows menyala dan port SMB terbuka.")
        except Exception as e:
            self.error.emit(f"Error memindai: {str(e)}")


class PaperCutProbeWorker(QThread):
    finished = Signal(dict, str)

    def __init__(self, host):
        super().__init__()
        self.host = host.strip()

    def run(self):
        try:
            self.finished.emit(probe_papercut(self.host), self.host)
        except Exception:
            self.finished.emit(
                {"host": self.host, "ipp_port": None, "ipp_scheme": None,
                 "web_url": None, "printers": []},
                self.host,
            )


class DriverCatalogWorker(QThread):
    finished = Signal(int)

    def run(self):
        try:
            count = len(load_driver_catalog())
        except Exception:
            count = 0
        self.finished.emit(count)


