from PySide6.QtGui import QIcon, QFont, QPalette, QColor, QDesktopServices
from PySide6.QtCore import QUrl

APP_NAME = "WinPrint Connect"
CONFIG_DIR = os.path.expanduser("~/.config/winprint-connect")
CONFIG_FILE = os.path.join(CONFIG_DIR, "history.json")
DEFAULT_HOST = "192.168.25.5"

DRIVERS = [
    ("auto", "Deteksi Otomatis (Rekomendasi)"),
    ("drv:///hp/hpcups.drv/hp-laserjet_professional_p1102.ppd", "HP LaserJet P1102 (hpcups)"),
    ("drv:///sample.drv/epson9.ppd", "Epson Dot Matrix 9-Pin (LX-310 / LX-300)"),
    ("drv:///sample.drv/epson24.ppd", "Epson Dot Matrix 24-Pin (LQ Series)"),
    ("gutenprint.5.3://escp2-l310/expert", "Epson Inkjet ESC/P2 (L310 / L3210 / L3150)"),
    ("drv:///sample.drv/generic.ppd", "Generic PostScript Printer"),
    ("drv:///sample.drv/generpcl.ppd", "Generic PCL Laser Printer"),
    ("raw", "Raw Passthrough (Windows Spooler)"),
]


# ============================================================================
# Helpers & Utilities
# ============================================================================

def extract_host(target: str) -> str:
    """Extract clean IP or hostname from display string like '192.168.41.2 (PMU-ACC1)'"""
    target = target.strip()
    m = re.match(r'^(\d{1,3}(?:\.\d{1,3}){3})', target)
    if m:
        return m.group(1)
    m = re.match(r'^([^\s()]+)', target)
    if m:
        return m.group(1)
    return target


def get_netbios_name(ip: str, timeout: float = 0.25) -> str:
    """Query NetBIOS Node Status (RFC 1002) over UDP 137 to resolve Windows Computer Name."""
    query = (
        b'\xa2\x48\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00'
        b'\x20CKAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\x00'
        b'\x00\x21\x00\x01'
    )
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        s.sendto(query, (ip, 137))
        data, _ = s.recvfrom(1024)
        if len(data) > 57:
            num_names = data[56]
            offset = 57
            for _ in range(num_names):
                if offset + 18 <= len(data):
                    name_bytes = data[offset:offset+15]
                    name_type = data[offset+15]
                    flags = struct.unpack('>H', data[offset+16:offset+18])[0]
                    offset += 18
                    if (flags & 0x8000) == 0 and name_type in (0x00, 0x20):
                        name = name_bytes.decode('ascii', errors='ignore').strip()
                        if name:
                            return name
    except Exception:
        pass
    finally:
        s.close()
    try:
        return socket.gethostbyaddr(ip)[0]
    except Exception:
        pass
    return ""


def get_active_subnet() -> str:
    """Detect local active IPv4 network interface CIDR."""
    try:
        res = subprocess.run(['ip', '-j', 'addr', 'show', 'up'], capture_output=True, text=True)
        data = json.loads(res.stdout)
        for iface in data:
            if iface.get('ifname') == 'lo':
                continue
            for addr in iface.get('addr_info', []):
                if addr.get('family') == 'inet':
                    return f"{addr['local']}/{addr['prefixlen']}"
    except Exception:
        pass
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(('8.8.8.8', 80))
        ip = s.getsockname()[0]
        s.close()
        return f"{ip}/24"
    except Exception:
        return "192.168.25.0/24"


def sanitize_cups_name(name: str) -> str:
    cleaned = re.sub(r'[^a-zA-Z0-9_\-]', '_', name)
    cleaned = re.sub(r'_+', '_', cleaned).strip('_')
    return cleaned or "printer"


def guess_driver_for_name(text: str) -> str:
    lower = text.lower()
    if "p1102" in lower or "laserjet professional" in lower:
        return "drv:///hp/hpcups.drv/hp-laserjet_professional_p1102.ppd"
    if any(k in lower for k in ["lx-310", "lx-300", "lx310", "lx300", "epson 9", "9-pin", "dot matrix"]):
        return "drv:///sample.drv/epson9.ppd"
    if any(k in lower for k in ["lq-310", "lq-2190", "lq310", "24-pin"]):
        return "drv:///sample.drv/epson24.ppd"
    if any(k in lower for k in ["l3210", "l3110", "l3150", "l310", "l120", "l210", "l220", "l360", "l380", "l4150", "l5190", "l6190", "l805"]):
        return "gutenprint.5.3://escp2-l310/expert"
    if "postscript" in lower or "ps" in lower:
        return "drv:///sample.drv/generic.ppd"
    if "laserjet" in lower or "pcl" in lower:
        return "drv:///sample.drv/generpcl.ppd"
    return "drv:///sample.drv/generic.ppd"


def get_installed_cups_printers() -> dict:
    installed = {}
    try:
        res = subprocess.run(["lpstat", "-v"], capture_output=True, text=True, timeout=5)
        for line in res.stdout.splitlines():
            m = re.match(r"^device for (.*?):\s+(.*)$", line)
            if m:
                pname = m.group(1).strip()
                uri = m.group(2).strip()
                installed[pname] = uri
    except Exception:
        pass
    return installed


def get_default_cups_printer() -> str:
    try:
        res = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, timeout=5)
        m = re.search(r"destination:\s*(\S+)", res.stdout)
        if m:
            return m.group(1).strip()
    except Exception:
        pass
    return ""


# ============================================================================
# Configuration Management
# ============================================================================

class ConfigManager:
    @staticmethod
    def load() -> dict:
        default_cfg = {
            "recent_hosts": [DEFAULT_HOST, "pc1"],
            "last_host": DEFAULT_HOST,
            "auth": {
                "remember": False,
                "username": "jasanet"
            }
        }
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    default_cfg.update(data)
            except Exception:
                pass
        return default_cfg

    @staticmethod
    def save(cfg: dict):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
        except Exception:
            pass


# ============================================================================
# Background Threads (Workers)
# ============================================================================

class SubnetScanWorker(QThread):
    finished = Signal(list)
    status = Signal(str)

    def run(self):
        self.status.emit("Mendeteksi antarmuka jaringan lokal...")
        cidr = get_active_subnet()
        net = ipaddress.IPv4Network(cidr, strict=False)
        self.status.emit(f"Memindai host SMB & nama PC di subnet {net.network_address}/{net.prefixlen}...")

        def check_host(ip_str):
            for port in (445, 139):
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(0.18)
                try:
                    if sock.connect_ex((ip_str, port)) == 0:
                        sock.close()
                        hostname = get_netbios_name(ip_str)
                        display = f"{ip_str} ({hostname})" if hostname else ip_str
                        return {"ip": ip_str, "hostname": hostname, "display": display}
                except Exception:
                    pass
                finally:
                    sock.close()
            return None

        # Scan up to 256 hosts in subnet
        hosts_to_scan = [str(h) for h in list(net.hosts())[:256]]
        found = []
        with ThreadPoolExecutor(max_workers=40) as pool:
            for item in pool.map(check_host, hosts_to_scan):
                if item:
                    found.append(item)

        self.finished.emit(found)


class SmbScanWorker(QThread):
    finished = Signal(list, str)
    error = Signal(str)

    def __init__(self, host, username="", password=""):
        super().__init__()
        self.host = host.strip()
        self.username = username.strip()
        self.password = password.strip()

    def run(self):
        if not self.host:
            self.error.emit("Silakan masukkan Hostname atau IP Windows.")
            return

        cmd = ["smbclient", "-L", f"//{self.host}"]
        if self.username:
            auth = f"{self.username}%{self.password}"
            cmd.extend(["-U", auth])
        else:
            cmd.append("-N")

        env = os.environ.copy()
        env["SMB_CONF_PATH"] = "/dev/null"

        try:
            res = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=10)
            output = res.stdout
            err = res.stderr

            if "NT_STATUS_LOGON_FAILURE" in err or "LOGON_FAILURE" in output:
                self.error.emit("Gagal login ke Windows: Username atau password salah.")
                return

            if "NT_STATUS_ACCESS_DENIED" in err and not self.username:
                self.error.emit("Akses ditolak: Windows memerlukan akun/password untuk melihat printer.")
                return

            printers = []
            for line in output.splitlines():
                m = re.match(r"^\t(?!.*?\bDisk\b)(.*?)\s+Printer\s*(.*)$", line)
                if m:
                    sharename = m.group(1).strip()
                    comment = m.group(2).strip()
                    printers.append({
                        "sharename": sharename,
                        "comment": comment,
                        "host": self.host
                    })

            self.finished.emit(printers, self.host)
        except subprocess.TimeoutExpired:
            self.error.emit(f"Koneksi timeout ke {self.host}. Pastikan PC Windows menyala dan port SMB terbuka.")
        except Exception as e:
            self.error.emit(f"Error memindai: {str(e)}")


# ============================================================================
# UI Component: PrinterCard
# ============================================================================

class PrinterCard(QFrame):
    status_changed = Signal()

    def __init__(self, printer_info, auth_info, parent=None):
        super().__init__(parent)
        self.printer_info = printer_info
        self.auth_info = auth_info
        self.sharename = printer_info["sharename"]
        self.comment = printer_info["comment"] or "Shared Windows Printer"
        self.host = printer_info["host"]
        self.cups_name = sanitize_cups_name(self.sharename)
        self.init_ui()

    def init_ui(self):
        self.setObjectName("PrinterCard")
        self.setFrameShape(QFrame.Shape.StyledPanel)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(16)

        # 1. Left: Printer Icon in styled container (44x44)
        icon_box = QFrame(self)
        icon_box.setObjectName("IconBox")
        icon_box.setFixedSize(48, 48)
        icon_box_layout = QVBoxLayout(icon_box)
        icon_box_layout.setContentsMargins(0, 0, 0, 0)
        icon_box_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        icon_lbl = QLabel(icon_box)
        icon = QIcon.fromTheme("printer", QIcon.fromTheme("printer-symbolic"))
        icon_lbl.setPixmap(icon.pixmap(32, 32))
        icon_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icon_box_layout.addWidget(icon_lbl)
        layout.addWidget(icon_box)

        # 2. Center: Metadata & Driver Selection
        info_layout = QVBoxLayout()
        info_layout.setSpacing(6)

        title_row = QHBoxLayout()
        title_row.setSpacing(8)

        self.name_lbl = QLabel(self.sharename, self)
        font_title = QFont()
        font_title.setPointSize(11)
        font_title.setBold(True)
        self.name_lbl.setFont(font_title)
        self.name_lbl.setToolTip(f"Nama share Windows: {self.sharename}")
        title_row.addWidget(self.name_lbl)

        # Badges
        self.badge_lbl = QLabel(self)
        self.badge_lbl.setFont(QFont("", 9, QFont.Weight.Bold))
        self.badge_lbl.setVisible(False)
        title_row.addWidget(self.badge_lbl)

        self.default_badge_lbl = QLabel(self)
        self.default_badge_lbl.setText("  ★ DEFAULT  ")
        self.default_badge_lbl.setStyleSheet("""
            background-color: #f39c12;
            color: #ffffff;
            border-radius: 4px;
            padding: 2px 6px;
            font-weight: bold;
            font-size: 10px;
        """)
        self.default_badge_lbl.setVisible(False)
        title_row.addWidget(self.default_badge_lbl)

        title_row.addStretch()
        info_layout.addLayout(title_row)

        # Meta Line
        self.desc_lbl = QLabel(f"Host: {self.host}  •  {self.comment}", self)
        self.desc_lbl.setObjectName("SubText")
        info_layout.addWidget(self.desc_lbl)

        # Driver row
        drv_row = QHBoxLayout()
        drv_row.setSpacing(8)
        drv_tag = QLabel("Driver:", self)
        drv_tag.setObjectName("SubText")
        self.drv_combo = QComboBox(self)
        self.drv_combo.setToolTip("Pilih driver pencocokan untuk printer ini")
        for val, label in DRIVERS:
            self.drv_combo.addItem(label, val)

        guessed = guess_driver_for_name(self.sharename + " " + self.comment)
        idx = self.drv_combo.findData(guessed)
        if idx >= 0:
            self.drv_combo.setCurrentIndex(idx)

        drv_row.addWidget(drv_tag)
        drv_row.addWidget(self.drv_combo)
        drv_row.addStretch()
        info_layout.addLayout(drv_row)

        layout.addLayout(info_layout, stretch=1)

        # 3. Right: Action Buttons
        self.btn_layout = QHBoxLayout()
        self.btn_layout.setSpacing(8)

        # Connect button
        self.btn_connect = QPushButton("Hubungkan", self)
        self.btn_connect.setIcon(QIcon.fromTheme("list-add", QIcon.fromTheme("dialog-ok")))
        self.btn_connect.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_connect.setToolTip("Daftarkan printer ini ke antrean CUPS Linux")
        self.btn_connect.clicked.connect(self.connect_printer)
        self.btn_layout.addWidget(self.btn_connect)

        # Test page button
        self.btn_test = QPushButton("Cetak Tes", self)
        self.btn_test.setIcon(QIcon.fromTheme("document-print"))
        self.btn_test.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_test.setToolTip("Kirim halaman uji coba cetak ke printer ini")
        self.btn_test.clicked.connect(self.print_test_page)
        self.btn_test.setVisible(False)
        self.btn_layout.addWidget(self.btn_test)

        # Make default button
        self.btn_default = QPushButton("Default", self)
        self.btn_default.setIcon(QIcon.fromTheme("emblem-default"))
        self.btn_default.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_default.setToolTip("Jadikan printer ini sebagai printer bawaan sistem")
        self.btn_default.clicked.connect(self.set_as_default)
        self.btn_default.setVisible(False)
        self.btn_layout.addWidget(self.btn_default)

        # Remove button
        self.btn_remove = QPushButton("Hapus", self)
        self.btn_remove.setIcon(QIcon.fromTheme("edit-delete"))
        self.btn_remove.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_remove.setObjectName("DangerButton")
        self.btn_remove.setToolTip("Hapus printer ini dari CUPS")
        self.btn_remove.clicked.connect(self.remove_printer)
        self.btn_remove.setVisible(False)
        self.btn_layout.addWidget(self.btn_remove)

        layout.addLayout(self.btn_layout)
        self.update_status()

    def update_status(self):
        installed = get_installed_cups_printers()
        default_printer = get_default_cups_printer()
        quoted = urllib.parse.quote(self.sharename).lower()
        raw = self.sharename.lower()

        matched_cups_name = None
        if self.cups_name in installed:
            matched_cups_name = self.cups_name
        else:
            for cname, uri in installed.items():
                uri_l = uri.lower()
                if (quoted in uri_l or raw in uri_l) and self.host in uri_l:
                    matched_cups_name = cname
                    break

        if matched_cups_name:
            self.cups_name = matched_cups_name
            self.badge_lbl.setText("  ✓ TERHUBUNG  ")
            self.badge_lbl.setStyleSheet("""
                background-color: #27ae60;
                color: #ffffff;
                border-radius: 4px;
                padding: 2px 8px;
                font-weight: bold;
                font-size: 10px;
            """)
            self.badge_lbl.setVisible(True)

            is_default = (self.cups_name == default_printer)
            self.default_badge_lbl.setVisible(is_default)
            self.btn_default.setEnabled(not is_default)

            self.desc_lbl.setText(f"Antrean CUPS: {self.cups_name}  •  Host: {self.host}  •  {self.comment}")
            self.btn_connect.setVisible(False)
            self.btn_test.setVisible(True)
            self.btn_default.setVisible(True)
            self.btn_remove.setVisible(True)
            self.drv_combo.setEnabled(False)
        else:
            self.badge_lbl.setVisible(False)
            self.default_badge_lbl.setVisible(False)
            self.desc_lbl.setText(f"Host: {self.host}  •  {self.comment}")
            self.btn_connect.setVisible(True)
            self.btn_connect.setText("Hubungkan")
            self.btn_connect.setObjectName("PrimaryButton")
            self.btn_test.setVisible(False)
            self.btn_default.setVisible(False)
            self.btn_remove.setVisible(False)
            self.drv_combo.setEnabled(True)

    def connect_printer(self):
        driver = self.drv_combo.currentData()
        if driver == "auto":
            driver = guess_driver_for_name(self.sharename + " " + self.comment)

        quoted_share = urllib.parse.quote(self.sharename)
        username = self.auth_info.get("username", "").strip()
        password = self.auth_info.get("password", "").strip()

        if username and password:
            uri = f"smb://{username}:{password}@{self.host}/{quoted_share}"
        elif username:
            uri = f"smb://{username}@{self.host}/{quoted_share}"
        else:
            uri = f"smb://{self.host}/{quoted_share}"

        cmd = [
            "lpadmin",
            "-p", self.cups_name,
            "-E",
            "-v", uri,
            "-D", f"{self.sharename} di {self.host}",
            "-L", f"Windows PC ({self.host})",
        ]

        if driver == "raw":
            cmd.extend(["-m", "raw"])
        else:
            cmd.extend(["-m", driver])

        if not (username and password):
            cmd.extend(["-o", "auth-info-required=username,password"])

        try:
            subprocess.run(cmd, capture_output=True, text=True, check=True)
            subprocess.run(["cupsenable", self.cups_name], check=False)
            subprocess.run(["cupsaccept", self.cups_name], check=False)
            self.update_status()
            self.status_changed.emit()
            QMessageBox.information(self, "Berhasil", f"Printer '{self.sharename}' berhasil ditambahkan ke CUPS!")
        except subprocess.CalledProcessError as e:
            err_msg = e.stderr or e.stdout or str(e)
            if "cups-driverd failed to get PPD" in err_msg:
                err_msg += (
                    "\n\nDriver PPD yang dipilih tidak tersedia di CUPS sistem ini."
                    "\nSaran: Coba ubah Driver ke 'Generic PostScript Printer', 'Generic PCL Laser', atau 'Raw Passthrough'."
                )
            QMessageBox.critical(self, "Gagal Menambahkan", f"Error saat menjalankan lpadmin:\n{err_msg}")

    def print_test_page(self):
        try:
            testfile = "/usr/share/cups/data/testprint"
            if os.path.exists(testfile):
                subprocess.run(["lp", "-d", self.cups_name, testfile], check=True)
            else:
                proc = subprocess.Popen(["lp", "-d", self.cups_name], stdin=subprocess.PIPE, text=True)
                proc.communicate(input=f"Test Print from WinPrint Connect\nPrinter: {self.sharename}\nHost: {self.host}\n")
            QMessageBox.information(self, "Cetak Terkirim", f"Halaman tes berhasil dikirim ke antrean '{self.cups_name}'.")
        except Exception as e:
            QMessageBox.warning(self, "Gagal Cetak", f"Tidak dapat mengirim tes cetak: {str(e)}")

    def set_as_default(self):
        try:
            subprocess.run(["lpadmin", "-d", self.cups_name], check=True)
            self.update_status()
            self.status_changed.emit()
            QMessageBox.information(self, "Default Printer", f"'{self.cups_name}' sekarang menjadi printer utama (default).")
        except Exception as e:
            QMessageBox.warning(self, "Gagal", str(e))

    def remove_printer(self):
        reply = QMessageBox.question(
            self, "Konfirmasi Hapus",
            f"Yakin ingin menghapus printer '{self.cups_name}' dari sistem Linux?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )
        if reply == QMessageBox.StandardButton.Yes:
            subprocess.run(["lpadmin", "-x", self.cups_name], check=False)
            self.update_status()
            self.status_changed.emit()


