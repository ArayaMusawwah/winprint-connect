    def start_driver_catalog_load(self):
        """Load `lpinfo -m` off the UI thread; it takes ~8s on a full CUPS install."""
        self.catalog_worker = DriverCatalogWorker()
        self.catalog_worker.finished.connect(self.on_driver_catalog_loaded)
        self.catalog_worker.start()

    def on_driver_catalog_loaded(self, count):
        self.catalog_count = count
        for i in range(self.scroll_layout.count()):
            widget = self.scroll_layout.itemAt(i).widget()
            if isinstance(widget, PrinterCard):
                widget.refresh_driver_catalog()
        if count:
            self.status_lbl.setToolTip(f"Katalog driver CUPS: {count} PPD terpasang")

    def toggle_auth_fields(self, checked):
        self.auth_widget.setVisible(checked)

    def _auth_username(self):
        return self.user_input.text().strip() if self.chk_auth.isChecked() else ""

    def _auth_password(self):
        return self.pass_input.text().strip() if self.chk_auth.isChecked() else ""

    def _auth_info(self):
        return {"username": self._auth_username(), "password": self._auth_password()}

    def save_host_to_history(self, host):
        recent = self.cfg.get("recent_hosts", [])
        if host in recent:
            recent.remove(host)
        recent.insert(0, host)
        self.cfg["recent_hosts"] = recent[:8]
        self.cfg["last_host"] = host
        self.cfg["auth"] = {
            "remember": self.chk_auth.isChecked(),
            "username": self.user_input.text().strip()
        }
        ConfigManager.save(self.cfg)

    def start_subnet_scan(self):
        self.btn_discover.setEnabled(False)
        self.btn_scan.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.status_lbl.setText("Memindai subnet lokal untuk menemukan PC Windows aktif...")

        self.subnet_worker = SubnetScanWorker()
        self.subnet_worker.status.connect(lambda msg: self.status_lbl.setText(msg))
        self.subnet_worker.finished.connect(self.on_subnet_scan_finished)
        self.subnet_worker.start()

    def on_subnet_scan_finished(self, found_hosts):
        self.btn_discover.setEnabled(True)
        self.btn_scan.setEnabled(True)
        self.progress_bar.setVisible(False)

        if not found_hosts:
            self.status_lbl.setText("Tidak ada PC SMB yang ditemukan di subnet lokal.")
            QMessageBox.information(self, "Hasil Scan LAN", "Tidak ditemukan PC Windows SMB aktif di subnet lokal.")
            return

        self.status_lbl.setText(f"Ditemukan {len(found_hosts)} PC Windows/SMB di jaringan lokal.")

        # Update ComboBox items with display string e.g. "192.168.41.2 (PMU-ACC1)"
        current_text = self.host_combo.currentText().strip()
        for item in reversed(found_hosts):
            disp = item["display"]
            idx = self.host_combo.findText(disp)
            if idx >= 0:
                self.host_combo.removeItem(idx)
            self.host_combo.insertItem(0, disp)

        if found_hosts and (not current_text or self.host_combo.findText(current_text) < 0):
            self.host_combo.setCurrentText(found_hosts[0]["display"])

    def start_papercut_probe(self):
        raw_target = self.host_combo.currentText().strip()
        if not raw_target:
            QMessageBox.warning(self, "Peringatan", "Harap pilih atau masukkan Host/IP Windows.")
            return
        host = extract_host(raw_target)
        self.save_host_to_history(raw_target)
        self.clear_papercut_cards()
        self.btn_papercut.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.status_lbl.setText(f"Mendeteksi PaperCut di {host}...")
        self._start_papercut_probe(host, silent=False)

    def start_scan(self):
        raw_target = self.host_combo.currentText().strip()
        if not raw_target:
            QMessageBox.warning(self, "Peringatan", "Harap pilih atau masukkan Host/IP Windows.")
            return

        clean_host = extract_host(raw_target)
        self.save_host_to_history(raw_target)
        self.btn_scan.setEnabled(False)
        self.btn_discover.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.status_lbl.setText(f"Menghubungi {raw_target} dan memindai printer yang dibagikan...")

        username = self.user_input.text().strip() if self.chk_auth.isChecked() else ""
        password = self.pass_input.text().strip() if self.chk_auth.isChecked() else ""

        self.smb_scan_done = False
        self._start_papercut_probe(clean_host, silent=True)

        self.worker = SmbScanWorker(clean_host, username, password)
        self.worker.finished.connect(self.on_scan_finished)
        self.worker.error.connect(self.on_scan_error)
        self.worker.start()

    def _start_papercut_probe(self, host, silent):
        self.papercut_probe_host = host
        worker = PaperCutProbeWorker(host)
        self.pc_workers.append(worker)
        worker.finished.connect(
            lambda result, h, s=silent: self.on_papercut_result(result, h, s)
        )
        worker.start()

    def on_scan_finished(self, printers, host):
        self.smb_scan_done = True
        self.btn_scan.setEnabled(True)
        self.btn_discover.setEnabled(True)
        self.progress_bar.setVisible(False)

        # Clear only printer cards; keep the empty-state placeholder and trailing stretch
        for i in range(self.scroll_layout.count() - 1, -1, -1):
            widget = self.scroll_layout.itemAt(i).widget()
            if isinstance(widget, PrinterCard):
                self.scroll_layout.takeAt(i)
                widget.deleteLater()

        self.apply_papercut_share_fallback(host, getattr(self.worker, "disk_shares", []))

        if not printers:
            self.status_lbl.setText(f"Tidak ada printer share yang ditemukan di {host}.")
            self.rescan_btn.setVisible(False)
            QMessageBox.information(
                self, "Hasil Pemindaian",
                f"Tidak ditemukan printer yang dibagikan di '{host}'.\nPastikan fitur 'Share this printer' telah diaktifkan pada Windows."
            )
            self._sync_empty_state()
            self._flush_papercut_pending()
            return

        self.status_lbl.setText(f"Ditemukan {len(printers)} printer share di {host}:")
        self.rescan_btn.setVisible(True)

        auth_info = self._auth_info()

        for p in printers:
            card = PrinterCard(p, auth_info, self.scroll_content)
            card.status_changed.connect(self.refresh_cards_status)
            self.scroll_layout.insertWidget(self.scroll_layout.count() - 1, card)

        self._sync_empty_state()
        self._flush_papercut_pending()

    def on_scan_error(self, err_msg):
        self.smb_scan_done = True
        self.btn_scan.setEnabled(True)
        self.btn_discover.setEnabled(True)
        self.progress_bar.setVisible(False)
        self.status_lbl.setText("Gagal memindai printer.")
        self._flush_papercut_pending()
        QMessageBox.warning(self, "Pemindaian Gagal", err_msg)

    def on_papercut_result(self, result, host, silent):
        self.btn_papercut.setEnabled(True)
        if host != self.papercut_probe_host:
            return
        if result.get("web_url"):
            self.papercut_web_url = result["web_url"]
            self.btn_papercut_web.setEnabled(True)
            self.btn_papercut_web.setToolTip(f"Buka halaman akun PaperCut: {result['web_url']}")
        if not self.smb_scan_done:
            self.papercut_pending = (result, host, silent)
            return
        self.render_papercut(result, host, silent)

    def apply_papercut_share_fallback(self, host, disk_shares):
        names = {d.lower() for d in disk_shares}
        if PAPERCUT_CLIENT_SHARE not in names or self.papercut_web_url:
            return
        url = f"http://{host}:9191/user"
        self.papercut_web_url = url
        self.btn_papercut_web.setEnabled(True)
        self.btn_papercut_web.setToolTip(
            f"Host membagikan PCClient (PaperCut NG/MF). Buka: {url}"
        )
        self.status_lbl.setText(
            f"PaperCut NG/MF terdeteksi di {host} (share PCClient). Klik 'Akun PaperCut' untuk cek kuota."
        )

    def _flush_papercut_pending(self):
        if self.papercut_pending is None:
            return
        result, host, silent = self.papercut_pending
        self.papercut_pending = None
        self.render_papercut(result, host, silent)

    def render_papercut(self, result, host, silent):
        self.clear_papercut_cards()
        printers = result.get("printers") or []
        auth_info = self._auth_info()
        for p in printers:
            card = PrinterCard({
                "kind": "papercut",
                "name": p["name"],
                "host": host,
                "port": result["ipp_port"],
                "scheme": result["ipp_scheme"],
            }, auth_info, self.scroll_content)
            card.status_changed.connect(self.refresh_cards_status)
            self.scroll_layout.insertWidget(self.scroll_layout.count() - 1, card)
        if printers:
            self.status_lbl.setText(f"PaperCut: {len(printers)} antrean ditemukan di {host}.")
            self.rescan_btn.setVisible(True)
        elif result.get("web_url") and not silent:
            self.status_lbl.setText(
                f"PaperCut NG/MF terdeteksi di {host}. Klik 'Akun PaperCut' untuk cek kuota; "
                "pakai 'Cari Printer' untuk antrean SMB."
            )
        elif not silent:
            QMessageBox.information(
                self, "PaperCut",
                f"Tidak ada layanan PaperCut di {host}.\n"
                "Port dicek: 9163/9164 (Mobility Print), 9191/9192 (NG/MF).",
            )
        self._sync_empty_state()
        self.progress_bar.setVisible(False)

    def clear_papercut_cards(self):
        for i in range(self.scroll_layout.count() - 1, -1, -1):
            widget = self.scroll_layout.itemAt(i).widget()
            if isinstance(widget, PrinterCard) and widget.kind == "papercut":
                self.scroll_layout.takeAt(i)
                widget.deleteLater()
        self._sync_empty_state()

    def _sync_empty_state(self):
        has_cards = any(
            isinstance(self.scroll_layout.itemAt(i).widget(), PrinterCard)
            for i in range(self.scroll_layout.count())
        )
        self.empty_state.setVisible(not has_cards)

    def open_papercut_account(self):
        if self.papercut_web_url:
            QDesktopServices.openUrl(QUrl(self.papercut_web_url))

    def refresh_cards_status(self):
        for i in range(self.scroll_layout.count() - 1):
            widget = self.scroll_layout.itemAt(i).widget()
            if isinstance(widget, PrinterCard):
                widget.update_status()

    def open_kde_settings(self):
        try:
            subprocess.Popen(["kcmshell6", "kcm_printer_manager"])
        except Exception:
            try:
                subprocess.Popen(["system-config-printer"])
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Tidak dapat membuka pengaturan: {str(e)}")


